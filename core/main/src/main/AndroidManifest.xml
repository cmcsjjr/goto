<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<queries>
        <!-- Package visibility for File Manager+ -->
        <package android:name="com.alphainventor.filemanager" />
        <!-- Intent visibility for general file pickers -->
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>
    
    <application>
        <provider
            android:name="com.rk.DocumentProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:icon="@mipmap/ic_launcher"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <service android:name="com.rk.settings.debugOptions.LogcatService" />

    </application>
</manifest>
